# ---- Core ----
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-use-at-least-32-random-characters
DATABASE_URL=sqlite:///instance/cloudvault.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=60

# ---- Dev helpers (set to false in production) ----
# Returns verification / reset links in API responses so you can test without SMTP
DEV_EXPOSE_TOKENS=true

# ---- Storage ----
STORAGE_BACKEND=local            # local | s3
STORAGE_ROOT=storage_data
# S3-compatible (AWS S3, MinIO, Cloudflare R2, Wasabi...)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Email (optional; without it, emails are written to instance/outbox.log) ----
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=CloudVault <no-reply@cloudvault.local>

# ---- Malware scanning (ClamAV clamd, optional) ----
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---- Production ----
TRUST_PROXY=false                # true when behind nginx / a load balancer
RATELIMIT_STORAGE_URI=memory://
